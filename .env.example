# ====================================================================
# TUNELYTICS CONFIGURATION
# ====================================================================

# Spotify Developer Application Credentials
# Create an app at https://developer.spotify.com/dashboard
# For Docker Compose: http://localhost:3000/callback
# For Local Vite Dev: http://localhost:5173/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# Database URL (SQLite default)
DATABASE_URL=sqlite:///./tunelytics.db

# Security
SECRET_KEY=change-me-to-a-secure-random-key-in-production

# Frontend Origin URL
FRONTEND_URL=http://localhost:3000

# Demo Mode (if true or credentials empty, demo mode is available without Spotify login)
DEMO_MODE=true
